{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xsl",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xsl; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), fullscreen=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://*.openfreemap.org https://tiles.openfreemap.org; media-src 'self' blob: https://res.cloudinary.com; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.cloudinary.com https://res.cloudinary.com https://api.mapbox.com https://events.mapbox.com https://tiles.openfreemap.org https://*.openfreemap.org https://nominatim.openstreetmap.org; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/_seo/sitemap.xml" },
    { "source": "/sitemap.xsl", "destination": "/_seo/sitemap.xsl" },
    { "source": "/robots.txt", "destination": "/_seo/robots.txt" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/features", "destination": "/features/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/careers", "destination": "/careers/index.html" },
    {
      "source": "/guides/memory-map",
      "destination": "/guides/memory-map/index.html"
    },
    {
      "source": "/guides/travel-memory-journal",
      "destination": "/guides/travel-memory-journal/index.html"
    },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/vi", "destination": "/vi/index.html" },
    { "source": "/vi/about", "destination": "/vi/about/index.html" },
    {
      "source": "/vi/features",
      "destination": "/vi/features/index.html"
    },
    { "source": "/vi/pricing", "destination": "/vi/pricing/index.html" },
    { "source": "/vi/faq", "destination": "/vi/faq/index.html" },
    {
      "source": "/vi/careers",
      "destination": "/vi/careers/index.html"
    },
    {
      "source": "/vi/guides/memory-map",
      "destination": "/vi/guides/memory-map/index.html"
    },
    {
      "source": "/vi/guides/travel-memory-journal",
      "destination": "/vi/guides/travel-memory-journal/index.html"
    },
    {
      "source": "/vi/privacy",
      "destination": "/vi/privacy/index.html"
    },
    { "source": "/vi/terms", "destination": "/vi/terms/index.html" },
    {
      "source": "/((?!_seo/|sitemap\\.xml|sitemap\\.xsl|robots\\.txt|llms\\.txt|llms-full\\.txt|BingSiteAuth\\.xml|6b4e9d7c1a8f3e2b5c0d9a7f4e1c8b6d\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
