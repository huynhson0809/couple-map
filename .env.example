VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_VAPID_PUBLIC_KEY=
VITE_MAPBOX_ACCESS_TOKEN=
# Public HTTPS profile URLs. Invalid or blank profiles stay hidden.
VITE_SOCIAL_LINKEDIN_URL=https://www.linkedin.com/company/pinly-tech
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_THREADS_URL=
VITE_SOCIAL_TIKTOK_URL=
VITE_SOCIAL_X_URL=
# true enables multiple spaces; false keeps one visible space and prefers a two-member space.
VITE_MULTI_SPACE_ENABLED=false
# true enables Pinly Replay; false hides all Replay entry points and routes.
VITE_YEAR_REPLAY_ENABLED=true

# Supabase Edge Function secrets. Set these with:
# supabase secrets set SEND_PUSH_SECRET=... STREAK_REMINDER_SECRET=...
# supabase secrets set CLOUDINARY_CLOUD_NAME=... CLOUDINARY_API_KEY=... CLOUDINARY_API_SECRET=...
# supabase secrets set RESEND_API_KEY=... SUPPORT_ADMIN_EMAIL=... SUPPORT_EMAIL_FROM=... APP_URL=https://pinly.tech
SEND_PUSH_SECRET=
STREAK_REMINDER_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
# Comma-separated addresses are supported.
SUPPORT_ADMIN_EMAIL=
# Example: Pinly Support <support@pinly.tech>
SUPPORT_EMAIL_FROM=
APP_URL=https://pinly.tech
# Optional maximum inclusive date range accepted by generate-memory-recap.
REPLAY_MAX_RANGE_DAYS=730
VITE_YEAR_REPLAY_ENABLED=
